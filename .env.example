# ANIZ AI configuration.
# Copy this file to `.env` and adjust. Never commit `.env` — it may hold secrets.

PORT=3210
# Local-first by default: only this machine can reach the server.
HOST=127.0.0.1

# Which provider to use: ollama | openai | mock
#   ollama  - a model running locally through Ollama (no account, no cost)
#   openai  - any OpenAI-compatible endpoint, local or cloud (needs the vars below)
#   mock    - a deterministic offline test double, not a language model
PROVIDER=ollama

# Local model through Ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:0.6b

# Optional OpenAI-compatible endpoint. Required only when PROVIDER=openai.
# Keep the key in `.env` only; never paste it into source or commit it.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Hard cap on a single assistant reply, in milliseconds (cold model loads are slow).
REQUEST_TIMEOUT_MS=300000

# Where conversations are stored. One JSON file, written atomically.
DATA_DIR=./data

# The only area the file tools may read or write. Tools cannot escape this.
WORKSPACE_DIR=./data/workspace

# Maximum tool-loop steps for one agent reply (1-20).
MAX_AGENT_STEPS=6
